{
  "manifest_version": 3,
  "name": "YouTube Quick Download",
  "version": "2.1.3",
  "description": "Tải nhanh video (MP4) hoặc âm thanh (MP3) từ YouTube qua máy chủ yt-dlp chạy trên máy của bạn.",
  "icons": {
    "16": "logoYTB.png",
    "32": "logoYTB.png",
    "48": "logoYTB.png",
    "128": "logoYTB.png"
  },
  "permissions": ["activeTab", "contextMenus", "downloads", "notifications", "scripting", "storage", "sidePanel"],
  "host_permissions": [
    "https://*.youtube.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "YouTube Quick Download",
    "default_icon": {
      "16": "logoYTB.png",
      "32": "logoYTB.png",
      "48": "logoYTB.png",
      "128": "logoYTB.png"
    },
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "download-mp3": {
      "suggested_key": { "default": "Alt+Shift+3" },
      "description": "Tải MP3 video YouTube hiện tại"
    },
    "download-mp4": {
      "suggested_key": { "default": "Alt+Shift+4" },
      "description": "Tải MP4 video YouTube hiện tại"
    }
  }
}
